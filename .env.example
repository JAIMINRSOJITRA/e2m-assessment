# ============================================================
# .env.example
# ============================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# This file is safe to commit. The actual .env file is NOT.
# ============================================================

# --- PRIMARY LLM: Google Gemini API Key ---
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_API_KEY_HERE

# --- SECONDARY LLM: Local Ollama Configuration ---
# Ollama runs locally at this base URL by default.
# Make sure Ollama is running before switching to Local LLM.
OLLAMA_BASE_URL=http://localhost:11434

# --- Default Ollama model to use for local inference ---
OLLAMA_MODEL=phi3

# --- Default Gemini model to use ---
GEMINI_MODEL=gemini-2.5-flash

# --- SQLite Database file path ---
# This file will be auto-created on first run.
DATABASE_URL=sqlite:///project_manager.db
